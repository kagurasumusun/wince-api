; btagsvc_network-doc.def -- btagsvc_network.lib export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (btagsvc_network.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY btagsvc_network.dll
EXPORTS
  BthAGNetworkAnswerCall
  BthAGNetworkDeinit
  BthAGNetworkDialNumber
  BthAGNetworkDropCall
  BthAGNetworkGetCallState
  BthAGNetworkHoldCall
  BthAGNetworkInit
  BthAGNetworkRejectCall
  BthAGNetworkSwapCall
  BthAGNetworkTransmitDTMF
  BthAGNetworkUnholdCall
