;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
LIBRARY coredll.dll
EXPORTS
  CompareFileTime
  CreateEventW
  CreateMutexW
  CreateProcessW
  CreateThread
  DuplicateHandle
  ExitProcess
  ExitThread
  FileTimeToLocalFileTime
  FileTimeToSystemTime
  FreeLibrary
  GetCommandLineW
  GetCurrentFT
  GetExitCodeProcess
  GetExitCodeThread
  GetFileTime
  GetIdleTime
  GetLocalTime
  GetModuleFileNameW
  GetModuleHandleW
  GetProcAddressW
  GetSystemInfo
  GetSystemTime
  GetThreadPriority
  GetTickCount
  GetVersionEx
  GlobalMemoryStatus
  HeapAlloc
  HeapCompact
  HeapCreate
  HeapDestroy
  HeapFree
  HeapReAlloc
  HeapSize
  HeapValidate
  InterlockedCompareExchange
  InterlockedCompareExchangePointer
  InterlockedDecrement
  InterlockedExchange
  InterlockedExchangeAdd
  InterlockedExchangePointer
  InterlockedIncrement
  InterlockedTestExchange
  IsBadCodePtr
  IsBadReadPtr
  IsBadWritePtr
  LoadLibraryW
  LoadLibraryExW
  LocalAlloc
  LocalFileTimeToFileTime
  LocalFree
  LocalReAlloc
  LocalSize
  OpenEventW
  OpenProcess
  PulseEvent
  QueryPerformanceCounter
  QueryPerformanceFrequency
  Random
  ReleaseSemaphore
  ResetEvent
  ResumeThread
  SetDaylightTime
  SetEvent
  SetFileTime
  SetLocalTime
  SetSystemTime
  SetThreadPriority
  SignalStarted
  Sleep
  SuspendThread
  SystemTimeToFileTime
  TerminateProcess
  TerminateThread
  TlsAlloc
  TlsFree
  TlsGetValue
  TlsSetValue
  TryEnterCriticalSection
  WaitForSingleObject
