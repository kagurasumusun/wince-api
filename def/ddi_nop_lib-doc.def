;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (ddi_nop_lib.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY ddi_nop_lib.dll
EXPORTS
  BRUSHOBJ_pvAllocRbrush
  BRUSHOBJ_pvGetRbrush
  CLIPOBJ_bEnum
  CLIPOBJ_cEnumStart
  DrvCopyBits
  DrvDisableDriver
  DrvGetModes
  DrvGradientFill
  DrvMovePointer
  DrvRealizeBrush
  DrvRealizeColor
  DrvTransparentBlt
  EngDeleteSurface
  PALOBJ_cGetColors
  PATHOBJ_bEnum
  PATHOBJ_vEnumStart
  XLATEOBJ_cGetPalette
