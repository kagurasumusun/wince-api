;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (coreloc.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY coreloc.dll
EXPORTS
  CharLowerW
  CharLowerBuffW
  CharPrevW
  CharUpperW
  CharUpperBuffW
  CompareStringW
  ConvertDefaultLocale
  EnumSystemCodePagesW
  FoldStringW
  GetACP
  GetCPInfo
  GetCurrencyFormatW
  GetDateFormatW
  GetLocaleInfoW
  GetNumberFormatW
  GetOEMCP
  GetStringTypeExW
  GetSystemDefaultLCID
  GetSystemDefaultLangID
  GetTimeFormatW
  GetUserDefaultLCID
  GetUserDefaultLangID
  IsCharAlphaW
  IsCharAlphaNumericW
  IsCharLowerW
  IsCharUpperW
  IsValidCodePage
  IsValidLocale
  LCMapStringW
  SetLocaleInfoW
  SetUserDefaultLCID
  wsprintfW
  wvsprintfW
