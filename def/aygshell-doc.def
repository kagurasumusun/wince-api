;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (aygshell.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY aygshell.dll
EXPORTS
  SHChangeNotifyDeregister
  SHChangeNotifyFree
  SHChangeNotifyRegister
  SHCloseApps
  SHCreateMenuBar
  SHCreateNewItem
  SHDoneButton
  SHEnumPropSheetHandlers
  SHFindMenuBar
  SHFreeContextMenuExtensions
  SHFullScreen
  SHGetAppKeyAssoc
  SHGetAutoRunPath
  SHGetEmergencyCallList
  SHGetInputContext
  SHHandleWMActivate
  SHHandleWMSettingChange
  SHInitDialog
  SHInitExtraControls
  SHInputDialog
  SHInvokeContextMenuCommand
  SHLoadContextMenuExtensions
  SHNavigateBack
  SHNotificationAdd
  SHNotificationGetData
  SHNotificationRemove
  SHNotificationUpdate
  SHRecognizeGesture
  SHSetAppKeyWndAssoc
  SHSetBack
  SHSetInputContext
  SHSetNavBarText
  SHSipInfo
  SHSipPreference
