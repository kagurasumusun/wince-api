; msdmo-doc.def -- msdmo.lib export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (Msdmo.lib); the on-device module name is
; not published by the CE documentation.
; Pages: DMOEnum aa451593, DMOGetName aa451596, DMOGetTypes
;   aa451597, DMOUnregister aa451611, DMOUnregisterFilter aa452530,
;   DMORegisterFilter aa452529 (Dmoreg.h), MoCopyMediaType ms932064,
;   MoCreateMediaType ms932065, MoDeleteMediaType ms932066,
;   MoDuplicateMediaType ms932067, MoFreeMediaType ms932068,
;   MoInitMediaType ms932077.  DMORegister aa451608 prints no
;   Requirements block (no Link Library row) -- excluded.
LIBRARY msdmo.dll
EXPORTS
  DMOEnum
  DMOGetName
  DMOGetTypes
  DMORegisterFilter
  DMOUnregister
  DMOUnregisterFilter
  MoCopyMediaType
  MoCreateMediaType
  MoDeleteMediaType
  MoDuplicateMediaType
  MoFreeMediaType
  MoInitMediaType
