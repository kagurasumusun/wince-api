; secur32-doc.def -- secur32.lib export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (secur32.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY secur32.dll
EXPORTS
  AcceptSecurityContext
  AcquireCredentialsHandle
  ApplyControlToken
  CeCredFree
  CeCredRead
  CeCredWrite
  CompleteAuthToken
  DecryptMessage
  DeleteSecurityContext
  EncryptMessage
  EnumerateSecurityPackages
  FreeContextBuffer
  FreeCredentialsHandle
  InitSecurityInterface
  InitializeSecurityContext
  InternetCanonicalizeUrl
  MakeSignature
  QueryContextAttributes
  QueryCredentialsAttributes
  QuerySecurityPackageInfo
  SealMessage
  UnsealMessage
  VerifySignature
