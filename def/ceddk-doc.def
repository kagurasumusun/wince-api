;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (ceddk.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY ceddk.dll
EXPORTS
  HalAllocateCommonBuffer
  HalFreeCommonBuffer
  HalGetBusData
  HalGetBusDataByOffset
  HalSetBusData
  HalSetBusDataByOffset
  HalTranslateBusAddress
  HalTranslateSystemAddress
  MmMapIoSpace
  MmUnmapIoSpace
  READ_PORT_BUFFER_UCHAR
  READ_PORT_BUFFER_ULONG
  READ_PORT_BUFFER_USHORT
  READ_PORT_UCHAR
  READ_PORT_ULONG
  READ_PORT_USHORT
  READ_REGISTER_BUFFER_UCHAR
  READ_REGISTER_BUFFER_ULONG
  READ_REGISTER_BUFFER_USHORT
  READ_REGISTER_UCHAR
  READ_REGISTER_ULONG
  READ_REGISTER_USHORT
  TransBusAddrToStatic
  TransBusAddrToVirtual
  WRITE_PORT_BUFFER_UCHAR
  WRITE_PORT_BUFFER_ULONG
  WRITE_PORT_BUFFER_USHORT
  WRITE_PORT_UCHAR
  WRITE_PORT_ULONG
  WRITE_PORT_USHORT
  WRITE_REGISTER_BUFFER_UCHAR
  WRITE_REGISTER_BUFFER_ULONG
  WRITE_REGISTER_BUFFER_USHORT
  WRITE_REGISTER_UCHAR
  WRITE_REGISTER_ULONG
  WRITE_REGISTER_USHORT
