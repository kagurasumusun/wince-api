; winscard-doc.def -- winscard.lib export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (winscard.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY winscard.dll
EXPORTS
  SCardBeginTransaction
  SCardCancel
  SCardConnect
  SCardControl
  SCardDisconnect
  SCardEndTransaction
  SCardEstablishContext
  SCardForgetCardType
  SCardForgetReader
  SCardFreeMemory
  SCardGetAttrib
  SCardGetCardTypeProviderName
  SCardGetProviderId
  SCardGetStatusChange
  SCardIntroduceCardType
  SCardIntroduceReader
  SCardIsValidContext
  SCardListCards
  SCardListInterfaces
  SCardListReaders
  SCardLocateCards
  SCardLocateCardsByATR
  SCardReconnect
  SCardReleaseContext
  SCardSetAttrib
  SCardSetCardTypeProviderName
  SCardStatus
  SCardTransmit
